# 复制成 .env 后按需修改，docker compose 会自动读取。

# 对外端口
WEB_PORT=8080

# 构建镜像时装依赖用的 npm 源；国内服务器可改成 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org

# 浏览器把模型请求发到这个同源地址；留空表示浏览器直连厂商（需要厂商允许跨域）
CHAT_PROXY_URL=/api/proxy

# 转发代理的校验令牌；公网部署时建议设置一串随机字符
CHAT_PROXY_TOKEN=

# 只允许转发到这些域名，逗号分隔；留空表示不限制
# 例：PROXY_ALLOWED_HOSTS=api.openai.com,api.siliconflow.cn,dashscope.aliyuncs.com
PROXY_ALLOWED_HOSTS=

# 预置厂商（JSON 数组，首次打开时出现在「设置 → 模型服务」里）。
# 不填也没关系，可以直接在页面里添加。示例：
# CHAT_PROVIDERS=[{"name":"硅基流动","protocol":"openai","baseUrl":"https://api.siliconflow.cn/v1","model":"deepseek-ai/DeepSeek-V3","apiKey":"sk-xxx"}]
CHAT_PROVIDERS=[]

# 左上角标题与 logo。留空用内置文案「API 使用 demo」；logo 可以填完整 URL，
# 也可以把图片放进容器（见 README）后用 /logo.png 这样的同源路径。
CHAT_APP_NAME=
CHAT_APP_LOGO=
